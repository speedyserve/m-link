HOST=0.0.0.0
PORT=8080

# LLM (OpenAI-compatible). Use GreenNode AIP as default for AgentBase.
LLM_API_KEY=
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=z-ai/glm-4.6
LLM_TEMPERATURE=0.3
LLM_ENABLED_FOR_CONTENT=true
# Each remote LLM attempt is capped; two attempts plus banking context remain
# below the API-level 30-second deadline and then fall back safely.
LLM_REQUEST_TIMEOUT_SECONDS=6

# M-Link Application integration. These secrets stay server-side.
APPLICATION_API_BASE_URL=http://localhost:4000
APPLICATION_INTERNAL_TOKEN=change-me-for-local-development
APPLICATION_API_TIMEOUT_SECONDS=10
INBOUND_AGENT_API_KEY=change-me-for-local-development
